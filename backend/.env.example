# Required in Render environment (do not commit real values)
DB_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/YOUR_DATABASE?sslMode=REQUIRED
DB_USERNAME=YOUR_AIVEN_USERNAME
DB_PASSWORD=YOUR_AIVEN_PASSWORD
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
FRONTEND_URL=https://srh-cinepass.vercel.app
PORT=8080

# Set to "production" on Render. Startup validation then requires the
# Razorpay values below; local development may leave them unset.
APP_ENV=development

# Razorpay credentials (server-side only; never expose these in VITE_* vars)
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
# From Razorpay Dashboard -> Settings -> Webhooks -> secret
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# ---------------------------------------------------------------------------
# TMDB (server-side only; never expose these in VITE_* vars)
#
# TMDB_ACCESS_TOKEN enables the automatic movie catalogue synchronisation.
# Without it the daily job skips the catalogue phase and still generates the
# shows. TMDB_SYNC_KEY protects the legacy manual sync endpoint.
# ---------------------------------------------------------------------------
TMDB_ACCESS_TOKEN=YOUR_TMDB_ACCESS_TOKEN
TMDB_SYNC_KEY=YOUR_TMDB_SYNC_KEY

# ---------------------------------------------------------------------------
# Movie automation switches (optional; the defaults are shown)
# ---------------------------------------------------------------------------
# Master switch for the TMDB catalogue synchronisation.
MOVIE_SYNC_ENABLED=true
# Master switch for the automatic 60-day movie retirement.
MOVIE_RETIREMENT_ENABLED=true
# Days after the Indian theatrical release date before a movie is retired.
MOVIE_RETIREMENT_DAYS=60
# Number of calendar dates in the rolling show window (today plus 6 more).
SHOW_SCHEDULER_HORIZON_DAYS=7

VITE_API_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
VITE_CURRENCY=INR
