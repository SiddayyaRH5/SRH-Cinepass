# Required in Render environment (do not commit real values)
DB_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/YOUR_DATABASE?sslMode=REQUIRED
DB_USERNAME=YOUR_AIVEN_USERNAME
DB_PASSWORD=YOUR_AIVEN_PASSWORD
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
FRONTEND_URL=https://srh-cinepass.vercel.app
PORT=8080

# Set to "production" on Render. Startup validation then requires the
# Razorpay values below; local development may leave them unset.
APP_ENV=development

# Razorpay credentials (server-side only; never expose these in VITE_* vars)
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
# From Razorpay Dashboard -> Settings -> Webhooks -> secret
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

VITE_API_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
VITE_CURRENCY=INR
