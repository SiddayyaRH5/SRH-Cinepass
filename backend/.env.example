# Required in Render environment (do not commit real values)
DB_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/YOUR_DATABASE?sslMode=REQUIRED
DB_USERNAME=YOUR_AIVEN_USERNAME
DB_PASSWORD=YOUR_AIVEN_PASSWORD
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
FRONTEND_URL=https://srh-cinepass.vercel.app
PORT=8080

# TMDB integration (never commit real credentials)
TMDB_ACCESS_TOKEN=your_tmdb_v4_read_access_token
TMDB_SYNC_KEY=generate_a_long_random_secret

# Conservative Aiven connection pool defaults (optional overrides)
DB_POOL_MAX_SIZE=4
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=15000
